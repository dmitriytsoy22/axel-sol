{
  "name": "axel-backend",
  "version": "0.1.0",
  "description": "AXEL backend: Yandex Fleet telemetry job, wallet sign-in and Sumsub KYC for axel_v2",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@solana/web3.js": "^1.98.0",
    "better-sqlite3": "^12.11.1",
    "cron": "^3.5.0",
    "i18n-iso-countries": "^7.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "rootDir": "src",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=20.19"
  }
}
