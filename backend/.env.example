# Copy to .env. Every value is validated at startup (src/config/app-config.ts); an invalid
# value stops the process. With NODE_ENV=production the backend refuses to start unless
# AXEL_PROGRAM_ID, CORS_ORIGINS, SIWS_URI, KYC_AUTHORITY_KEYPAIR_PATH and all SUMSUB_* values
# except SUMSUB_BASE_URL are set, and it requires https origins.
# NODE_ENV=production

# Server port. Code default when unset: 3000, which clashes with `next dev`;
# 3001 matches the frontend's default NEXT_PUBLIC_TELEMETRY_API_URL.
PORT=3001

# Frontend origins allowed by CORS, comma-separated. Default: http://localhost:3000
# CORS_ORIGINS=https://axel.example,https://preview.axel.example

# Number of reverse proxies in front of the backend, so rate limits see the client IP.
# Default: 0 (trust none).
# TRUST_PROXY=1

# --- Solana ---------------------------------------------------------------------------

# RPC endpoint. Default: http://127.0.0.1:8899 (local validator).
SOLANA_RPC_URL=http://127.0.0.1:8899

# Cluster name written into the sign-in message: mainnet, devnet, testnet or localnet.
# Default: devnet
# SOLANA_CLUSTER=devnet

# axel_v2 program ID. Default: the address in src/solana/idl/axel_v2.json.
# AXEL_PROGRAM_ID=AXLcoEH3vJXUSL7nEr1T4d77NarThcbVrnbBzBR8XPZi

# --- KYC -------------------------------------------------------------------------------

# SQLite file for sign-in nonces, wallet-to-applicant bindings and the webhook log.
# Default: data/axel-backend.sqlite (relative to the working directory).
# DATABASE_PATH=data/axel-backend.sqlite

# Keypair of Config.kyc_authority, the only key that signs set_investor. Keep it separate
# from the admin and oracle keys. Without it, webhooks answer 503 and Sumsub retries them.
# KYC_AUTHORITY_KEYPAIR_PATH=/path/to/kyc-authority.json

# Origin of the frontend that asks wallets to sign in; its host is the message's domain.
# Default: http://localhost:3000
# SIWS_URI=https://axel.example

# Sumsub API credentials (Dashboard → Dev space → App tokens), used to create WebSDK
# tokens and to confirm approvals.
# SUMSUB_BASE_URL=https://api.sumsub.com
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# Verification level the WebSDK runs; approvals for any other level are ignored.
# Default: basic-kyc-level
# SUMSUB_LEVEL_NAME=basic-kyc-level

# Secret of the webhook (Dashboard → Dev space → Webhooks). Without it every webhook
# request is refused; signature checking is never skipped.
# SUMSUB_WEBHOOK_SECRET=

# --- Telemetry -------------------------------------------------------------------------

# Project mint address (identifies the project for telemetry)
# PROJECT_MINT=

# Vehicle license plate (matched against Yandex orders)
# VEHICLE_LICENSE_PLATE=

# Yandex Fleet API credentials; without them the telemetry job uses simulated data
# https://fleet.yandex.ru/developers/api
# YANDEX_PARK_ID=
# YANDEX_CLIENT_ID=
# YANDEX_API_KEY=

# Cron schedule for telemetry ingestion, in server local time. Default: 0 1 * * * (01:00).
# CRON_SCHEDULE=0 1 * * *
