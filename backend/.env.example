# Copy to .env. Every value is validated at startup (src/config/app-config.ts); an invalid
# value stops the process. With NODE_ENV=production the backend refuses to start unless
# AXEL_PROGRAM_ID, CORS_ORIGINS, SIWS_URI, KYC_AUTHORITY_KEYPAIR_PATH and all SUMSUB_* values
# except SUMSUB_BASE_URL are set, and it requires https origins. It also needs
# ORACLE_KEYPAIR_PATH as soon as FLEET_CONFIG lists a car.
# NODE_ENV=production

# Server port. Code default when unset: 3000, which clashes with `next dev`;
# 3001 matches the frontend's default NEXT_PUBLIC_TELEMETRY_API_URL.
PORT=3001

# Frontend origins allowed by CORS, comma-separated. Default: http://localhost:3000
# CORS_ORIGINS=https://axel.example,https://preview.axel.example

# Number of reverse proxies in front of the backend, so rate limits see the client IP.
# Default: 0 (trust none).
# TRUST_PROXY=1

# --- Solana ---------------------------------------------------------------------------

# RPC endpoint (http:// or https://). Default: http://127.0.0.1:8899 (local validator).
SOLANA_RPC_URL=http://127.0.0.1:8899

# Cluster name written into the sign-in message: mainnet, devnet, testnet or localnet.
# Default: devnet
# SOLANA_CLUSTER=devnet

# axel_v2 program ID. Default: the address in src/solana/idl/axel_v2.json.
# AXEL_PROGRAM_ID=AXLcoEH3vJXUSL7nEr1T4d77NarThcbVrnbBzBR8XPZi

# --- KYC -------------------------------------------------------------------------------

# SQLite file for sign-in nonces, wallet-to-applicant bindings, the webhook log, the published
# telemetry days, the attested revenue reports and the indexed program events. Back it up: the
# published texts are what the on-chain hashes commit to. The file belongs to one cluster: after
# resetting a local validator, point this at a new file, or the event indexer halts.
# Default: data/axel-backend.sqlite (relative to the working directory).
# DATABASE_PATH=data/axel-backend.sqlite

# Keypair of Config.kyc_authority, the only key that signs set_investor. Keep it separate
# from the admin and oracle keys. Without it, webhooks answer 503 and Sumsub retries them.
# KYC_AUTHORITY_KEYPAIR_PATH=/path/to/kyc-authority.json

# Origin of the frontend that asks wallets to sign in; its host is the message's domain.
# Default: http://localhost:3000
# SIWS_URI=https://axel.example

# Sumsub API credentials (Dashboard → Dev space → App tokens), used to create WebSDK
# tokens and to confirm approvals.
# SUMSUB_BASE_URL=https://api.sumsub.com
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# Verification level the WebSDK runs; approvals for any other level are ignored.
# Default: basic-kyc-level
# SUMSUB_LEVEL_NAME=basic-kyc-level

# Secret of the webhook (Dashboard → Dev space → Webhooks). Without it every webhook
# request is refused; signature checking is never skipped.
# SUMSUB_WEBHOOK_SECRET=

# --- Fleet, telemetry and attestation --------------------------------------------------

# The cars this backend reports for: a JSON object keyed by share mint. Per car:
#   plate               licence plate as the fleet system stores it (spaces and Cyrillic
#                       look-alike letters are normalised)
#   source              "yandex_fleet" (needs the YANDEX_* credentials) or "simulated"
#   parkFeeBps          the park's management fee, in basis points of the rent
#   simulatedDailyRent  KZT charged on an active simulated day (simulated cars only)
#   startDate           first day to collect, YYYY-MM-DD (optional; default: yesterday)
# Simulated cars are published with data_origin "simulated" and refused on mainnet.
# Default: {} (no cars).
# FLEET_CONFIG={"<share mint>":{"plate":"777 AXL 02","source":"simulated","parkFeeBps":1500,"simulatedDailyRent":12000}}

# UTC offset of the fleet's time zone; it decides where a reported day starts and ends.
# Default: +05:00 (Kazakhstan).
# FLEET_UTC_OFFSET=+05:00

# Keypair of Project.oracle for the cars above. It signs record_telemetry batches (and pays
# their fees) and co-signs revenue deposits. Keep it separate from the admin, operator and KYC
# keys. Without it, days are still collected but nothing is written on-chain, and
# /reports/attest and /v2/deposits/draft answer 503.
# ORACLE_KEYPAIR_PATH=/path/to/oracle.json

# Yandex Fleet API credentials of the park (https://fleet.yandex.ru/developers/api). Required
# when a car's source is yandex_fleet; there is no fallback to simulated data.
# YANDEX_PARK_ID=
# YANDEX_CLIENT_ID=
# YANDEX_API_KEY=
# Transaction categories that count as the park's rent charge, comma-separated.
# Default: partner_service_recurring_payment
# YANDEX_RENT_CATEGORY_IDS=partner_service_recurring_payment

# Cron schedule of the daily telemetry job, in server local time. Default: 0 1 * * * (01:00).
# CRON_SCHEDULE=0 1 * * *

# --- Event indexer ---------------------------------------------------------------------

# Keeps the history of axel_v2 events in the SQLite file for /events, /projects/:mint/history
# and /positions/:owner/claims. Default: true. With false the RPC is left alone and the
# endpoints serve what is already stored.
# INDEXER_ENABLED=true

# RPC for the history reads (getSignaturesForAddress, getTransaction), e.g. a provider with a
# higher rate limit than SOLANA_RPC_URL. Default: SOLANA_RPC_URL.
# INDEXER_RPC_URL=https://api.devnet.solana.com

# Websocket for logsSubscribe. Default: the indexer RPC as ws:// or wss://, on the next port
# when it has one (http://127.0.0.1:8899 -> ws://127.0.0.1:8900/), keeping any query string.
# INDEXER_WS_URL=wss://api.devnet.solana.com

# How often the indexer checks for transactions the log subscription missed, in ms.
# Default: 30000 (1000 to 3600000).
# INDEXER_POLL_INTERVAL_MS=30000
