# Solana RPC endpoint (localnet / devnet / mainnet).
# The programs are deployed on devnet; use http://127.0.0.1:8899 for a local validator.
# Code default when unset: http://127.0.0.1:8899
SOLANA_RPC_URL=https://api.devnet.solana.com

# Server port. Code default when unset: 3000, which clashes with `next dev`;
# 3001 matches the frontend's default NEXT_PUBLIC_TELEMETRY_API_URL.
PORT=3001

# The axel program ID (DJMyW18aG1g48c534cC2VsaQh15pPan2tMBDkhyhQX1M) is hardcoded in
# src/kyc/kyc.service.ts and src/telemetry/telemetry-cron.service.ts; it is not read from env.

# Project mint address (identifies the project for telemetry)
# PROJECT_MINT=

# Oracle keypair path (for record_telemetry signing)
# ORACLE_KEYPAIR_PATH=/path/to/oracle-keypair.json

# Vehicle license plate (matched against Yandex orders)
# VEHICLE_LICENSE_PLATE=

# Yandex Fleet API credentials; without them the telemetry job uses simulated data
# https://fleet.yandex.ru/developers/api
# YANDEX_PARK_ID=
# YANDEX_CLIENT_ID=
# YANDEX_API_KEY=

# Cron schedule for telemetry ingestion (default: daily at 01:00).
# Read by the @Cron decorator before this file is loaded, so a value set here is
# ignored; export it in the shell instead: CRON_SCHEDULE="0 1 * * *" npm run start:prod
# CRON_SCHEDULE=0 1 * * *

# Sumsub KYC webhook secret (HMAC-SHA256 signature verification).
# If empty, signature verification is skipped and any caller of POST /kyc/webhook can
# trigger add_to_whitelist. Always set it together with ADMIN_KEYPAIR_PATH.
# SUMSUB_WEBHOOK_SECRET=

# Admin keypair path (for add_to_whitelist signing on KYC approval)
# ADMIN_KEYPAIR_PATH=/path/to/admin-keypair.json
