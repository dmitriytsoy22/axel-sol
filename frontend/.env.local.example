# Cluster the app reads from: devnet, testnet, mainnet-beta or localnet (solana-test-validator)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# RPC node; defaults to the cluster's public endpoint (http://127.0.0.1:8899 for localnet)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# axel_v2 program; defaults to the address in src/lib/solana/idl-v2/axel_v2.json
# NEXT_PUBLIC_PROGRAM_ID=AXLcoEH3vJXUSL7nEr1T4d77NarThcbVrnbBzBR8XPZi

# Symbols of payment mints that carry no on-chain metadata: "<mint>:<symbol>,<mint>:<symbol>"
# NEXT_PUBLIC_PAYMENT_MINT_SYMBOLS=

# AXEL backend: GET /telemetry/latest/:shareMint. Unset: the car page says trip data is not connected.
NEXT_PUBLIC_TELEMETRY_API_URL=http://localhost:3000

# AXEL indexer: GET /v2/wallets/:wallet/payouts. Unset: payout history is read from the chain.
# NEXT_PUBLIC_INDEXER_URL=

# Where each car's published telemetry, reports and purchase papers live: <base>/<share mint>/index.json.
# Defaults to /demo-data (the seed's files in public/demo-data) on test networks; set it on mainnet.
# NEXT_PUBLIC_PUBLISHED_DATA_URL=

# Public site URL, for the absolute links and icon of the Blinks (/api/actions/*).
# Unset: taken from the request's host, as the proxy in front reports it.
# NEXT_PUBLIC_SITE_URL=https://axel.example

# Test builds only: adds the "E2E Burner" wallet, which signs with a key kept in localStorage,
# for the Playwright suite (npm run test:e2e sets it). Ignored on mainnet. Never set it on a deployment.
# NEXT_PUBLIC_E2E=1

# ── Judge demo (/demo and /api/demo/*): devnet and localnet only, 404 on any other cluster ──
# Shows "Get demo access" (banner, mobile menu, car page) and the /demo page.
# NEXT_PUBLIC_DEMO_ACCESS=1

# Server-only keys of the demo roles, as base58 secret keys or solana-keygen JSON arrays. Each
# holds one role and nothing else; the admin, KYC authority and upgrade keys never go here.
# `DEMO_SEED_SECRET=... node scripts/demo-env.mjs --cluster devnet --fleet <mint>` prints them
# for a cluster the demo seed filled (the fleet mint is demo.demo_fleet in its output).
# DEMO_FAUCET_SECRET=     fee payer and SOL pool of every demo transaction; mint authority of tKZT.
#                         Fund it: about 0.018 SOL per judge (rent of the KYC record, token accounts
#                         and position, plus the 0.01 SOL drip) and 0.0024 SOL per simulated month.
# DEMO_KYC_SECRET=        Config.demo_kyc_authority (writes DEMO records only)
# DEMO_DESK_SECRET=       holds the demo fleet car's share inventory
# DEMO_OPERATOR_SECRET=   the demo fleet car's operator
# DEMO_ORACLE_SECRET=     the demo fleet car's oracle, which co-signs its deposits
# DEMO_FLEET_MINT=        share mint of the demo fleet car
# DEMO_SESSION_SECRET=    signs nonces and sessions; at least 32 characters (openssl rand -hex 32)

# A server-side RPC for the demo routes and Blinks, e.g. a keyed Helius URL. Unset: NEXT_PUBLIC_SOLANA_RPC_URL.
# DEMO_RPC_URL=

# Shared limits across serverless instances (Upstash Redis REST). Unset: in-memory limits,
# which each server process keeps on its own; fine for one `next start`, not for Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile on the access request. Set both, or neither.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
