# Cluster the app reads from: devnet, testnet, mainnet-beta or localnet (solana-test-validator)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# RPC node; defaults to the cluster's public endpoint (http://127.0.0.1:8899 for localnet)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# axel_v2 program; defaults to the address in src/lib/solana/idl-v2/axel_v2.json
# NEXT_PUBLIC_PROGRAM_ID=AXLcoEH3vJXUSL7nEr1T4d77NarThcbVrnbBzBR8XPZi

# Symbols of payment mints that carry no on-chain metadata: "<mint>:<symbol>,<mint>:<symbol>"
# NEXT_PUBLIC_PAYMENT_MINT_SYMBOLS=

# AXEL backend: GET /telemetry/latest/:shareMint. Unset: the car page says trip data is not connected.
NEXT_PUBLIC_TELEMETRY_API_URL=http://localhost:3000

# AXEL indexer: GET /v2/wallets/:wallet/payouts. Unset: payout history is read from the chain.
# NEXT_PUBLIC_INDEXER_URL=
