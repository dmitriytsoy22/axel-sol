{
  "name": "axel",
  "version": "0.1.0",
  "description": "RWA taxi tokenization on Solana",
  "type": "module",
  "scripts": {
    "test": "node --import tsx/esm --test tests/**/*.ts",
    "pretest:v2": "[ tests-v2/node_modules/.package-lock.json -nt tests-v2/package-lock.json ] || npm --prefix tests-v2 ci --no-audit --no-fund",
    "test:v2": "npm --prefix tests-v2 test",
    "build": "anchor build",
    "export-idl": "cp target/idl/axel_v2.json frontend/src/lib/solana/idl-v2/axel_v2.json && sed 's|IDL can be found at `target/idl/axel_v2.json`.|IDL can be found at `axel_v2.json` next to this file.|' target/types/axel_v2.ts > frontend/src/lib/solana/idl-v2/axel_v2.ts",
    "generate": "npx tsx scripts/generate-clients.ts",
    "init-project": "npx tsx scripts/init-project.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "latest",
    "@codama/renderers-js": "latest",
    "@solana/spl-token": "^0.4.14",
    "@types/node": "latest",
    "anchor-bankrun": "^0.5.0",
    "codama": "latest",
    "solana-bankrun": "^0.4.0",
    "solana-kite": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@solana/program-client-core": "^6.6.0"
  }
}
